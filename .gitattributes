# These make the retry-with-rebase loop in .github/workflows/*.yml (see the
# "Commit updated state/logs/dashboard" steps) actually able to recover from
# a concurrent write, instead of hitting a real content conflict like the
# one on 2026-09-05 (dashboard.html + a price_log.csv both conflicted when
# two scheduled runs pushed within the same few seconds).

# Append-only logs: two runs each appending one line should never conflict -
# union-merge keeps both lines instead of flagging a line-level conflict.
# Never used for state/*.json (a real single-object file where a genuine
# conflict should surface, not be silently mashed together).
logs/**/*.csv merge=union

# dashboard.html is fully regenerated by every single run - a conflict here
# is never meaningful (whichever version "wins" gets overwritten fresh on
# the very next run anyway), so always keep our own version on conflict
# rather than let it block the push. Requires `git config merge.ours.driver
# true` once per checkout - already added to every workflow that commits
# this file.
dashboard.html merge=ours
